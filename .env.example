# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_DOCS=true
API_PORT=8000

# SQLite file that holds delivered orders until their email is sent.
# On Render this is set to the persistent disk: /var/data/inkup.db
DATABASE_PATH=data/inkup.db

# ---------------------------------------------------------------------------
# Shiprocket webhook
# ---------------------------------------------------------------------------
# Set the same value in Shiprocket: Settings -> API -> Webhook -> Token,
# with Auth Token Type = x-api-key. Required in production.
WEBHOOK_TOKEN=replace-with-a-long-random-secret
WEBHOOK_MAX_BODY_BYTES=1048576

# Shiprocket's shipment_status_id for Delivered is 7. Add more ids only if your
# account emits a different delivered code.
DELIVERED_STATUS_IDS=7

# ---------------------------------------------------------------------------
# Delayed review request
# ---------------------------------------------------------------------------
# 259200 seconds = exactly 3 days. Keep this value in production.
# For a quick local test, set e.g. 60 to get the email a minute after delivery.
REVIEW_DELAY_SECONDS=259200
# How often the app checks for emails that are due, and how many per check.
REVIEW_CHECK_INTERVAL_SECONDS=300
REVIEW_BATCH_SIZE=50
# Temporary failures (Resend down, wrong password, ...) are retried; give up after this.
REVIEW_MAX_ATTEMPTS=24

# Ignore "delivered" events older than this (14 days), so a replayed or very
# late webhook cannot email a customer weeks after delivery.
REVIEW_MAX_DELIVERY_AGE_SECONDS=1209600
# Shiprocket timestamps carry no timezone; they are IST.
SHIPROCKET_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Shiprocket API user: buyer email/name + products for a delivered order
# (Shiprocket's webhook has neither). Required in production.
# Shiprocket -> Settings -> API -> Configure -> Create an API User. Give it
# the Listings + Shipments (+ Order) modules. Its token (10 days) is
# refreshed automatically.
# ---------------------------------------------------------------------------
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in

# ---------------------------------------------------------------------------
# Shopify Admin API: exact product handles for the review links. No customer
# data is requested, so this works on the Basic plan. Required in production.
#
# Apps created since 2026-01-01 (Dev Dashboard): dev.shopify.com/dashboard ->
# your app -> Settings -> copy Client ID and Client secret. The app version
# needs scopes read_orders, read_products (+ read_all_orders for orders older
# than 60 days) and must be installed on the store. The service exchanges these
# for a 24-hour access token automatically.
# ---------------------------------------------------------------------------
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only for an OLD custom app made in the Shopify admin before 2026 (shpat_...).
# Leave empty when using the client id/secret above.
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Storefront / email content
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=aman-testing-store.myshopify.com
STOREFRONT_BASE_URL=https://aman-testing-store.myshopify.com
STORE_NAME=Aman Testing Store
SUPPORT_EMAIL=
REVIEW_EMAIL_SUBJECT=How was your order?

# ---------------------------------------------------------------------------
# Resend (https://resend.com)
# ---------------------------------------------------------------------------
# For a quick free-tier test you can use onboarding@resend.dev, but Resend will
# only deliver to the email address that owns the Resend account. For real
# traffic, verify your own domain and use an address on it.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Aman Testing Store
RESEND_REPLY_TO=
RESEND_TIMEOUT_SECONDS=15
